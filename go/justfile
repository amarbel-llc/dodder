update-go:
  env GOPROXY=direct go get -u -t ./...
  go mod tidy

update-flake-input input:
  #!/usr/bin/env bash
  set -euo pipefail
  nix flake update "{{input}}" --flake ..
  git add ../flake.lock
  # If the input is a Go module, update go.mod to match the locked rev.
  # Some monorepos publish their Go module from a subdirectory (e.g.
  # code.linenisgreat.com/madder/go) — read go.mod to find the exact
  # module path that contains amarbel-llc/{{input}} and pass that to
  # `go get`. Falls back to the bare path when no longer-form match is
  # found. For goFlakeInputs-bridged inputs (madder, hyphence, piggy,
  # tap, tommy, purse-first) the nix build ignores this go.mod rev and
  # builds from
  # the flake input just refreshed above; the `go get` here only keeps
  # the vestigial shadow rev aligned for the bare-`go test` /
  # devshell-`go build` escape hatches (see resync-flake-go).
  rev=$(jq -r '.nodes["{{input}}"].locked.rev // empty' ../flake.lock)
  if [[ -n "${rev}" ]]; then
    mod_path=$(awk '/^[[:space:]]*github\.com\/amarbel-llc\/{{input}}([\/].*)?[[:space:]]/ { print $1; exit }' go.mod)
    if [[ -n "${mod_path}" ]]; then
      mod_before=$(grep -E "^[[:space:]]*${mod_path}[[:space:]]" go.mod || true)
      GOPROXY=direct go get "${mod_path}@${rev}"
      go mod tidy
      mod_after=$(grep -E "^[[:space:]]*${mod_path}[[:space:]]" go.mod || true)
      if [[ "${mod_before}" == "${mod_after}" ]]; then
        echo "error: go.mod entry for ${mod_path} did not change after 'go get @${rev}'" >&2
        echo "       before: ${mod_before}" >&2
        echo "       after:  ${mod_after}" >&2
        exit 1
      fi
      gomod2nix
    fi
  fi

# Re-pin every goFlakeInputs-bridged Go module in go.mod to the rev its
# flake input is currently locked at, then regenerate go.sum +
# gomod2nix.toml. Fixes the drift where a bulk `nix flake update` /
# flake.lock refresh bumps a bridged input's flake rev without
# re-pinning go.mod.
#
# For the bridged deps the go.mod rev is VESTIGIAL: every nix-routed
# build — the release binary, dodder-debug, the canonical unit tests
# (dodder-go-test, i.e. `just test-go-unit`), race, cover, and every
# bats lane — compiles those deps from the flake-input source via
# gomod.nix goFlakeInputs, NOT from the go.mod rev or the
# gomod2nix.toml hash. flake.lock is the source of truth for anything
# that ships or gates CI. The go.mod require LINE must still exist (Go
# module validity), and a few escape hatches do read its rev — the
# `test-go-pkg` bare `go test`, the coverage recipe's `go test ./...`,
# and a developer's manual `go build` / gopls — so this recipe keeps
# the shadow rev aligned with flake.lock so those degrade-to-go.mod
# paths match what nix ships.
#
# Run this after any bulk flake.lock refresh. The bridged set is derived
# from go.mod — each github.com/amarbel-llc/<name>/... require whose
# <name> matches a flake input in flake.lock; amarbel-llc deps with no
# matching flake input are skipped (not bridged).
resync-flake-go:
  #!/usr/bin/env bash
  set -euo pipefail
  changed=0
  while read -r mod_path; do
    input=$(sed -E 's#^github\.com/amarbel-llc/([^/]+).*#\1#' <<<"${mod_path}")
    rev=$(jq -r --arg i "${input}" '.nodes[$i].locked.rev // empty' ../flake.lock)
    if [[ -z "${rev}" ]]; then
      echo "skip ${mod_path} (no flake input '${input}' in flake.lock)"
      continue
    fi
    echo "resync ${mod_path} -> ${input}@${rev}"
    GOPROXY=direct go get "${mod_path}@${rev}"
    changed=1
  done < <(awk '/^[[:space:]]*github\.com\/amarbel-llc\// { print $1 }' go.mod)
  if [[ "${changed}" == "1" ]]; then
    go mod tidy
    gomod2nix
    git add go.mod go.sum gomod2nix.toml
  else
    echo "no bridged modules to resync"
  fi

update: update-go

