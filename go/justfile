# The tommy/peg generators emit code that is not goimports/gofumpt-clean
# (e.g. no blank line between top-level funcs), so conformist (via
# codemod-go-fmt) runs afterward to canonicalize the generated output. Without
# this the conformist check gate would fail after every build (which
# regenerates codegen).
build-go-generate: && codemod-go-fmt
  nix develop .. -c go generate ./lib/...
  nix develop .. -c go generate ./lib/0/...
  nix develop .. -c go generate ./internal/...
  nix develop .. -c go generate ./internal/0/...

# Regenerate codegen and commit in one step
commit-codegen: build-go-generate
  #! /usr/bin/env fish
  set -l changed (git diff --name-only -- '*.go' | grep -E '_tommy\.go$|_string\.go$|_stringer\.go$')
  if test -z "$changed"
    echo "no codegen changes"
    return 0
  end
  git add $changed
  git commit -m "chore: regenerate codegen"

build-go-binary tags output:
  mkdir -p '{{output}}'
  go build -tags '{{tags}}' -o '{{output}}' ./cmd/*

