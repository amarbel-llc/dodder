# Read-only formatting/lint gate via conformist: builds the flake's
# checks.formatting derivation (`conformist check` against a /nix/store
# snapshot of the tracked tree, same Nix-generated config `nix fmt` uses,
# plus the presets.eng convention linters). Exits non-zero if any file would
# be reformatted (drift) or a linter finds an issue. Wired into the pre-merge
# lane via the root `lint` recipe.
check-conformist:
  #!/usr/bin/env bash
  set -euo pipefail
  nix build --no-link --print-build-logs \
    "..#checks.$(nix eval --raw --impure --expr builtins.currentSystem).formatting"

# Read-only shellcheck gate for tracked shell scripts (*.sh/*.bash). Lives
# OUTSIDE the conformist config on purpose (a holdover from the conformist.toml
# era, when the shared eng hooks' wrapper had no shellcheck on PATH —
# amarbel-llc/eng#222, dodder#323; folding it into conformist.nix as a
# [linter.shellcheck] lane is now possible and tracked as a followup). Mirrors
# the retired treelint.toml linter's scope: excludes go/vimdiff.bash (vendored
# upstream git-vimdiff harness) and the frozen
# zz-tests_bats/previous_versions/** snapshots. Wired into the pre-merge lane
# via the root `lint` recipe. Uses the dev-shell shellcheck (same build the
# old linter drove).
check-shellcheck:
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{ justfile_directory() }}/.."
  mapfile -t files < <(
    git ls-files '*.sh' '*.bash' |
      grep -vE '^(go/vimdiff\.bash$|zz-tests_bats/previous_versions/)'
  )
  if [ "${#files[@]}" -eq 0 ]; then
    exit 0
  fi
  shellcheck "${files[@]}"

check: check-go-vuln check-go-vet check-go-repool check-go-seqerror check-go-defererr check-go-versions check-conformist check-shellcheck test-go-unit

