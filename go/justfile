test-go-unit *flags:
  tap-dancer go-test {{flags}} -skip-empty -count=1 -tags test,debug ./...

test-go: test-go-unit

test-bats-generate $PATH=(dir_build / "debug" + ":" + env("PATH")) $DODDER_BIN=(dir_build / "debug" / "dodder"):
  just ../zz-tests_bats/test-generate_fixtures

test-bats-run $PATH=(dir_build / "debug" + ":" + env("PATH")) $DODDER_BIN=(dir_build / "debug" / "dodder"):
  just ../zz-tests_bats/test

test-bats $PATH=(dir_build / "debug" + ":" + env("PATH")) $DODDER_BIN=(dir_build / "debug" / "dodder"):
  just ../zz-tests_bats/test-generate_fixtures
  just ../zz-tests_bats/test

# Runs all bats tests but filters output to only show failed test files
test-bats-failed_files $PATH=(dir_build / "debug" + ":" + env("PATH")) $DODDER_BIN=(dir_build / "debug" / "dodder"):
  just ../zz-tests_bats/test-generate_fixtures
  just ../zz-tests_bats/test | \
    grep "#  in test file " | \
    grep -o '[^[:space:]]*\.bats' | \
    sort -u

# Build coverage-instrumented binaries and run bats, writing coverage to build/cover-data.
# GOCOVERDIR must be under /tmp so sandcastle's allowWrite permits it.
test-bats-cover: build-go-cover
  #!/usr/bin/env bash
  set -euo pipefail
  export DODDER_CEILING_DIRECTORIES="{{absolute_path("..")}}"
  export PATH="{{dir_build}}/debug:$PATH"
  just ../zz-tests_bats/test-generate_fixtures
  cover_data="/tmp/dodder-cover-$$"
  rm -rf "$cover_data"
  mkdir -p "$cover_data"
  GOCOVERDIR="$cover_data" \
    BATS_BIN_DIR="{{dir_build}}/cover-bin" \
    just ../zz-tests_bats/test
  mkdir -p "{{dir_build}}/cover-data"
  go tool covdata textfmt -i="$cover_data" -o="{{dir_build}}/cover-data/bats-coverage.out"
  rm -rf "$cover_data"
  echo "==> Coverage written to {{dir_build}}/cover-data/bats-coverage.out"
  echo "    View with: go tool cover -func={{dir_build}}/cover-data/bats-coverage.out"

# Build race-instrumented binaries and run bats to detect data races.
test-bats-race: build-go-race
  #!/usr/bin/env bash
  set -euo pipefail
  export DODDER_CEILING_DIRECTORIES="{{absolute_path("..")}}"
  export PATH="{{dir_build}}/debug:$PATH"
  just ../zz-tests_bats/test-generate_fixtures
  BATS_BIN_DIR="{{dir_build}}/race" \
    just ../zz-tests_bats/test

test-bats-next *args:
  DODDER_BIN=der-next just ../zz-tests_bats/test-generate_fixtures
  DODDER_BIN=der-next just ../zz-tests_bats/test {{args}}

test: test-go test-bats

