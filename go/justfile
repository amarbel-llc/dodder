# Runs the Go unit test suite inside the nix sandbox (see go/go-tests.nix).
# Sandboxing is load-bearing: madder's MakeBlobStores merges the developer's
# real ~/.local/share/madder/ into any process-level XDG override, so bare
# `go test` can leak across the test/dev boundary. For tight per-package
# iteration, use `test-go-pkg` (the unsandboxed escape hatch).
test-go-unit:
  nix build .#dodder-go-test -L

test-go-pkg pkg *flags:
  go test -tags test,debug -v -count=1 {{flags}} {{pkg}}

test-go: test-go-unit

test-bats-generate:
  #!/usr/bin/env bash
  set -euo pipefail
  bin=$(nix build --no-link --print-out-paths '..#dodder-debug')
  export PATH="$bin/bin:$PATH"
  export DODDER_BIN="$bin/bin/dodder"
  just ../zz-tests_bats/test-generate_fixtures

test-bats-run:
  #!/usr/bin/env bash
  set -euo pipefail
  bin=$(nix build --no-link --print-out-paths '..#dodder-debug')
  export PATH="$bin/bin:$PATH"
  export DODDER_BIN="$bin/bin/dodder"
  just ../zz-tests_bats/test

test-bats:
  #!/usr/bin/env bash
  set -euo pipefail
