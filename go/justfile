# Codegen for the gate lane. Does NOT build a native binary: the root `build`
# recipe (`just go/build-go`) is the pre-merge gate's build step, and a naked
# `go build` there reads go.mod, whose rev for the 7 goFlakeInputs-bridged deps
# is vestigial (see gomod.nix) — the authoritative build is build-nix, which
# compiles them from the flake input. Wiring the naked build into the gate made
# it break whenever go.mod lagged flake.lock (e.g. a madder bump whose go-side
# resync hadn't run). For an ad-hoc native binary use
# `just build-go-binary debug build/debug`. See dodder#349.
build-go: build-go-generate

build-nix-gomod:
  gomod2nix

# TODO improve performance of this
build-nix: build-nix-gomod
  nix build .. --no-link

build-docker: build-nix-gomod
  docker load < "$(nix build "../#docker.x86_64-linux" --print-out-paths)"

