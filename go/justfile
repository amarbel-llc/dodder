# Format the whole repo via conformist (treefmt successor): goimports + gofumpt
# for Go, nixfmt for *.nix, shfmt for shell, stylua for *.lua, rustfmt for *.rs,
# tommy for *.toml. `nix fmt` runs the flake's module-generated wrapper, which
# bakes the config and every formatter as store paths, so it works regardless
# of the dev-shell. Config is Nix-generated from the repo-root conformist.nix
# (see conformist-nix(7)); the retired hand-written conformist.toml is gone.
codemod-go-fmt: codemod-go-fix_redundant_import_aliases
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{ justfile_directory() }}/.."
  nix fmt

# Reposition packages across NATO tiers based on their import graph. Runs
# the dagnabit binary against ./lib and ./internal so packages with no
# dependents can compact to lower tiers, and packages reaching higher
# tiers get bumped up. Pass *flags="-dry-run" or *flags="-verbose -n" to
# preview without moving.
codemod-go-reposition-packages *flags: && codemod-go-fmt
  go run ./cmd/dagnabit {{flags}}

# moves a go package from one <root>/<leaf> to another <root>/<leaf>
codemod-go-move_package src dst: && codemod-go-fmt
  #! /bin/bash -e

  prefix=code.linenisgreat.com/dodder/go
  original="{{src}}"
  renamed="{{dst}}"
  original="${original%/}"
  renamed="${renamed%/}"

  original_pkg="$(basename "$original")"
  renamed_pkg="$(basename "$renamed")"

  gofmt -w -r "$original_pkg.E -> $renamed_pkg.E" ./
  gofmt -w -r "$original_pkg -> $renamed_pkg" ./

  mkdir -p "$renamed"

  git mv $original/* "$renamed" || mv $original/* "$renamed"
  find internal lib -type d -empty -delete

  # https://unix.stackexchange.com/questions/190334/sed-word-boundaries-on-macos
  declare -r sed_script="
    s|\\b$prefix/$original\\b|$prefix/$renamed|g;
    s|^package $original_pkg\$|package $renamed_pkg|g;
  "

  ag "$prefix/$original" -l0 </dev/null |
    xargs -0 sed -i'' "$sed_script" || true

# [explore] one-shot: drop dodder's lib/0/http_statuses vendored copy in
# favor of dewey's. Byte-identical files modulo import paths.
[group('explore')]
explore-drop-http-statuses-fork:
  #!/usr/bin/env bash
  set -euo pipefail
  cd ..

  dodder_hs='code.linenisgreat.com/dodder/go/lib/0/http_statuses'
  dewey_hs='github.com/amarbel-llc/purse-first/libs/dewey/0/http_statuses'

  echo "==> rewriting http_statuses imports in all *.go files under go/"
  find go -name '*.go' -type f \
    \! -path 'go/lib/0/http_statuses/*' \
    -print0 | xargs -0 sed -i \
      -e "s|${dodder_hs}|${dewey_hs}|g"

  echo "==> deleting dodder's vendored http_statuses copy"
  rm -rf go/lib/0/http_statuses
  rmdir go/lib/0 2>/dev/null || true

  echo "==> done"

