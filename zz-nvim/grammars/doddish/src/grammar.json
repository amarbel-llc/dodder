        "value": "[ \\t\\n]+"
      }
    },
    "_element": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "term"
        },
        {
          "type": "SYMBOL",
          "name": "group"
        },
        {
          "type": "SYMBOL",
          "name": "negation"
        }
      ]
    },
    "negation": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "^"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "term"
            },
            {
              "type": "SYMBOL",
              "name": "group"
            }
          ]
        }
      ]
    },
    "group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_group_item"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "STRING",
                        "value": ","
                      },
                      {
                        "type": "SYMBOL",
                        "name": "_group_item"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "sigil"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "genres"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_group_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_bare_term"
        },
        {
          "type": "SYMBOL",
          "name": "group_negation"
        }
      ]
    },
    "group_negation": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "^"
        },
        {
          "type": "SYMBOL",
          "name": "_bare_term"
        }
      ]
    },
    "term": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_bare_term"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "genres"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_bare_term": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_predicate"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "sigil"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "sigil"
        }
      ]
    },
    "_predicate": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "exact"
        },
        {
          "type": "SYMBOL",
          "name": "type_filter"
        },
        {
          "type": "SYMBOL",
          "name": "object_id"
        },
        {
          "type": "SYMBOL",
          "name": "dependent_tag"
        },
        {
          "type": "SYMBOL",
          "name": "tag"
        }
      ]
    },
    "exact": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "type_filter"
            },
            {
              "type": "SYMBOL",
              "name": "tag"
            }
          ]
        }
      ]
    },
    "type_filter": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
