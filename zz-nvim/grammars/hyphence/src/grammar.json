{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "hyphence",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "metadata"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "body"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "body": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\n\\n(.|\\n)*"
      }
    },
    "metadata": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "---"
        },
        {
          "type": "STRING",
          "value": "\n"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_metadata_line"
          }
        },
        {
          "type": "STRING",
          "value": "---"
        }
      ]
    },
    "_metadata_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "description_line"
        },
        {
          "type": "SYMBOL",
          "name": "tag_line"
        },
        {
          "type": "SYMBOL",
          "name": "blob_line"
        },
        {
          "type": "SYMBOL",
          "name": "type_line"
        },
        {
          "type": "SYMBOL",
          "name": "ref_line"
        },
        {
          "type": "SYMBOL",
          "name": "comment_line"
        }
      ]
    },
    "description_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "text",
          "content": {
            "type": "SYMBOL",
            "name": "description_text"
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "description_text": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n]+"
      }
    },
    "tag_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "tag_name"
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "tag_name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n]+"
      }
    },
    "ref_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "ref",
          "content": {
            "type": "SYMBOL",
            "name": "reference_id"
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "reference_id": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n]+"
      }
    },
    "type_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "!"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "SYMBOL",
            "name": "type_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "@"
                },
                {
                  "type": "FIELD",
                  "name": "lock",
                  "content": {
                    "type": "SYMBOL",
                    "name": "markl_id"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "type_name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^@\\n]+"
      }
    },
    "blob_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "ref",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "markl_id"
              },
              {
                "type": "SYMBOL",
                "name": "file_path"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "file_path": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n@]*\\.[^\\n@.]+"
      }
    },
    "comment_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "text",
              "content": {
                "type": "SYMBOL",
                "name": "comment_text"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "comment_text": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n]+"
      }
    },
    "markl_id": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "markl_purpose"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "format",
          "content": {
            "type": "SYMBOL",
            "name": "markl_format"
          }
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "FIELD",
          "name": "data",
          "content": {
            "type": "SYMBOL",
            "name": "markl_data"
          }
        }
      ]
    },
    "markl_purpose": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-z0-9_][a-z0-9_-]*@"
      }
    },
    "markl_format": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-z0-9_]+"
      }
    },
    "markl_data": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-z0-9]+"
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
