{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "dodder_organize",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "metadata"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_body_line"
          }
        }
      ]
    },
    "_body_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "heading"
        },
        {
          "type": "SYMBOL",
          "name": "object_line"
        },
        {
          "type": "SYMBOL",
          "name": "blank_line"
        }
      ]
    },
    "blank_line": {
      "type": "STRING",
      "value": "\n"
    },
    "heading": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "marker",
          "content": {
            "type": "SYMBOL",
            "name": "heading_marker"
          }
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "heading_tag"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_heading_comma"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "heading_tag"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "heading_marker": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#+"
      }
    },
    "_heading_comma": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": ",[ \\t]*"
      }
    },
    "heading_tag": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n,]+"
      }
    },
    "object_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "prefix",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "-"
              },
              {
                "type": "STRING",
                "value": "%"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "SYMBOL",
          "name": "box"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": " "
                },
                {
                  "type": "FIELD",
                  "name": "description",
                  "content": {
                    "type": "SYMBOL",
                    "name": "description"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "description": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n]+"
      }
    },
    "metadata": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "---"
        },
        {
          "type": "STRING",
          "value": "\n"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_metadata_line"
          }
        },
        {
          "type": "STRING",
          "value": "---"
        }
      ]
    },
    "_metadata_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "description_line"
        },
        {
          "type": "SYMBOL",
          "name": "tag_line"
        },
        {
          "type": "SYMBOL",
          "name": "blob_line"
        },
        {
          "type": "SYMBOL",
          "name": "type_line"
        },
        {
          "type": "SYMBOL",
          "name": "ref_line"
        },
        {
          "type": "SYMBOL",
          "name": "comment_line"
        }
      ]
    },
    "description_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "text",
          "content": {
            "type": "SYMBOL",
            "name": "description_text"
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "description_text": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n]+"
      }
    },
    "tag_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "tag_name"
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "tag_name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n]+"
      }
    },
    "ref_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "ref",
          "content": {
            "type": "SYMBOL",
            "name": "reference_id"
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "reference_id": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n]+"
      }
    },
    "type_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "!"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "SYMBOL",
            "name": "type_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "@"
                },
                {
                  "type": "FIELD",
                  "name": "lock",
                  "content": {
                    "type": "SYMBOL",
                    "name": "markl_id"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "type_name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^@\\n]+"
      }
    },
    "blob_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "ref",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "markl_id"
              },
              {
                "type": "SYMBOL",
                "name": "file_path"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "file_path": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n@]*\\.[^\\n@.]+"
      }
    },
    "comment_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "text",
              "content": {
                "type": "SYMBOL",
                "name": "comment_text"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "comment_text": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n]+"
      }
    },
    "box": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_box_item"
              },
              {
                "type": "SYMBOL",
                "name": "_box_space"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "_box_space": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[ \\t]+"
      }
    },
    "_box_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "box_blob"
        },
        {
          "type": "SYMBOL",
          "name": "box_type"
        },
        {
          "type": "SYMBOL",
          "name": "box_computed_tag"
        },
        {
          "type": "SYMBOL",
          "name": "box_field"
        },
        {
          "type": "SYMBOL",
          "name": "box_object_id"
        },
        {
          "type": "SYMBOL",
          "name": "box_quoted"
        },
        {
          "type": "SYMBOL",
          "name": "box_tag"
        }
      ]
    },
    "box_blob": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "SYMBOL",
          "name": "markl_id"
        }
      ]
    },
    "box_type": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "!"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "box_ident"
          }
        }
      ]
    },
    "box_computed_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "box_ident"
          }
        }
      ]
    },
    "box_field": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "box_ident"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_box_value"
          }
        }
      ]
    },
    "_box_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "box_quoted"
        },
        {
          "type": "SYMBOL",
          "name": "box_bare_value"
        }
      ]
    },
    "box_bare_value": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^ \\t\\]\"]+"
      }
    },
    "box_object_id": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "left",
              "content": {
                "type": "SYMBOL",
                "name": "box_ident"
              }
            },
            {
              "type": "STRING",
              "value": "/"
            },
            {
              "type": "FIELD",
              "name": "right",
              "content": {
                "type": "SYMBOL",
                "name": "box_ident"
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "/"
            },
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "SYMBOL",
                "name": "box_ident"
              }
            }
          ]
        }
      ]
    },
    "box_tag": {
      "type": "SYMBOL",
      "name": "box_ident"
    },
    "box_ident": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z0-9][a-zA-Z0-9_-]*"
      }
    },
    "box_quoted": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "box_escape"
              },
              {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PATTERN",
                  "value": "[^\"\\\\]+"
                }
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "box_escape": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\\\."
      }
    },
    "markl_id": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "markl_purpose"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "format",
          "content": {
            "type": "SYMBOL",
            "name": "markl_format"
          }
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "FIELD",
          "name": "data",
          "content": {
            "type": "SYMBOL",
            "name": "markl_data"
          }
        }
      ]
    },
    "markl_purpose": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-z0-9_][a-z0-9_-]*@"
      }
    },
    "markl_format": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-z0-9_]+"
      }
    },
    "markl_data": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-z0-9]+"
      }
    }
  },
  "extras": [],
  "conflicts": [
    [
      "box_object_id",
      "box_tag"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
