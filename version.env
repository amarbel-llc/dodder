# eng-versioning(7): the single source of truth for this repo's release
# version. `just bump-version` sed-rewrites this file; flake.nix reads it
# via builtins.match (dodder's Go module lives in go/, so
# buildGoApplication's version.env auto-read can't reach a repo-root file —
# see the dodderVersion comment in flake.nix).
export DODDER_VERSION=0.2.15
